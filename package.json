{
  "name": "vacaciones-herramientas",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSpec y CodeGraph para especificaciones y contexto de código; las aplicaciones conservan sus propios paquetes.",
  "scripts": {
    "graph": "codegraph",
    "graph:status": "codegraph status",
    "graph:sync": "codegraph sync",
    "spec": "openspec",
    "spec:check": "openspec validate --all --strict",
    "spec:list": "openspec list --specs"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.6.2",
    "@fission-ai/openspec": "1.14.2"
  }
}
